[Unit]
Description=AnswerRank web: landing page, unsubscribe, console (behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=answerrank
WorkingDirectory=/opt/answerrank
EnvironmentFile=-/opt/answerrank/.env
# --no-fleet: the fleet has its own service (answerrank-fleet). `web` starts one
# by default, and two fleets for one business send every email twice.
# 127.0.0.1: only Caddy, which adds HTTPS, is reachable from outside.
ExecStart=/opt/answerrank/.venv/bin/python run.py web --no-fleet --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/answerrank/data

[Install]
WantedBy=multi-user.target
