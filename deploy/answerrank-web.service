[Unit]
Description=AnswerRank public web surface (landing + unsubscribe)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=answerrank
WorkingDirectory=/opt/answerrank
EnvironmentFile=/opt/answerrank/.env
ExecStart=/usr/bin/python3 run.py web --port 8000
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/answerrank/data

[Install]
WantedBy=multi-user.target
