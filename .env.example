# Copy to .env and fill in. Never commit .env.

# --- AI engines (optional; simulation runs without any) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
SERPER_API_KEY=

# --- Sending (required before any email goes out) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Overrides (normally set in answerrank.yml instead) ---
# ANSWERRANK_WEBSITE=https://yourdomain.com
# ANSWERRANK_FROM_EMAIL=hello@yourdomain.com
